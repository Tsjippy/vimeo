  "license": "ISC",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "tus-js-client": "^4.3.1"
  }
}
