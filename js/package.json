{
  "name": "vimeo",
  "version": "1.0.0",
  "description": "Vimeo",
  "main": "./vimeo.js",
  "scripts": {
    "library": "webpack --entry ./vimeo_library.js --output-path . --output-filename vimeo_library.min.js --progress --mode=production --devtool source-map",
    "upload": "webpack --config vimeo_library.config.js",
    "admin": "webpack --entry ./admin.js --output-path . --output-filename admin.min.js --progress --mode=production --devtool source-map",
    "all": "run-p upload admin library"
  },
